generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String               @id @default(cuid())
  email                 String               @unique
  password              String?
  provider              String? // "google" | "apple" | null
  providerId            String? // the Google sub field
  name                  String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  isVerified            Boolean              @default(false)
  verificationToken     String?              @unique
  verificationExpiresAt DateTime?
  PasswordResetToken    PasswordResetToken[]
  Container             Container[]
  Item                  Item[]
  Activity              Activity[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Container {
  id          String        @id @default(cuid())
  type        ContainerType @default(BOX)
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  name        String
  description String?
  location    String? // e.g., Room / Shelf / Storage area
  imageId     String?
  pinned      Boolean       @default(false)
  updatedAt   DateTime      @updatedAt
  createdAt   DateTime      @default(now())
  items       Item[]
}

model Item {
  id          String     @id @default(cuid())
  name        String
  description String?
  tags        String[]   @default([]) // simple tags array for now
  imageId     String?
  quantity    Int        @default(1)
  containerId String?
  container   Container? @relation(fields: [containerId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Activity {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     String // "item_created", "container_updated", "item_moved", etc.
  message  String // pre-built human-readable description
  metadata Json? // store IDs like { itemId: "...", containerId: "..." }

  createdAt DateTime @default(now())
}

enum ContainerType {
  BOX
}
