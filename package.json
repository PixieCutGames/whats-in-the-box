{
  "name": "whats-in-the-box",
  "author": "Pixiecut Games",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "ts-node-dev --respawn --transpile-only server.ts",
    "lint": "npx @biomejs/biome lint --write ./src",
    "prisma:generate": "prisma generate --no-engine",
    "prisma:migrate": "prisma migrate dev",
    "prepare": "npm run prisma:generate"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^10.0.0",
    "@prisma/client": "^6.19.0",
    "@prisma/extension-accelerate": "^2.0.2",
    "argon2": "^0.44.0",
    "fastify": "5.6.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.4",
    "@types/node": "20.11.17",
    "prisma": "^6.19.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "5.8.3"
  }
}