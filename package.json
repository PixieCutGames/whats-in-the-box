{
  "name": "whats-in-the-box",
  "author": "Pixiecut Games",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts --log-level=trace",
    "start": "tsx server.ts",
    "build": "tsc",
    "lint": "npx @biomejs/biome lint --write ./src",
    "prisma:generate": "prisma generate --no-engine",
    "prisma:migrate": "prisma migrate dev",
    "prepare": "npm run prisma:generate"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.3.0",
    "@prisma/client": "^6.19.0",
    "@prisma/extension-accelerate": "^2.0.2",
    "argon2": "^0.44.0",
    "cloudinary": "^2.8.0",
    "fastify": "5.6.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.4",
    "@types/node": "20.11.17",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "5.8.3"
  }
}
